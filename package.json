{
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2"
  },
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./public/styles.css -o ./public/output.css",
    "dev:tailwind": "npx @tailwindcss/cli -i ./public/styles.css -o ./public/output.css  --watch",
